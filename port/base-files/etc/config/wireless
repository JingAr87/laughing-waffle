# Initial wireless configuration for D-Link DIR-X1860Z / DIR-X3060Z (OpenWrt)
# /etc/init.d/e2631-wifi-load (S95) stages caldata and binds mt7915e outside
# the early boot path, then brings up both APs automatically.

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'soc/f000000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option band '2g'
	option channel '1'
	option htmode 'HE40'
	option noscan '1'
	option country 'MY'
	option disabled '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'soc/f000000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0+1'
	option band '5g'
	option channel '36'
	option htmode 'HE80'
	option country 'MY'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'OpenWrt-ZXIC'
	option encryption 'none'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'OpenWrt-ZXIC-5G'
	option encryption 'none'
	option disabled '0'
