From: Antigravity <dev@openwrt.org>
Subject: [PATCH] wifi: mt76: add pre-GRO RX fast-path hook for ZX279128R IDM offload

Allow the built-in zx279128s-eth IDM offload engine to intercept confirmed
L2 LAN unicast and PPE-offloaded L3 IPv4 SNAT frames in mt76_rx_complete()
before napi_gro_receive() coalesces them above 1500B MTU, and batch the
IDM_TX_DOORBELL write once per NAPI burst.

--- a/mac80211.c
+++ b/mac80211.c
@@ -5,6 +5,11 @@
 #include <linux/sched.h>
 #include <linux/of.h>
 #include "mt76.h"
+
+#ifdef CONFIG_ZX279128S_ETH
+extern bool zx_idm_wifi_rx(struct sk_buff *skb);
+extern void zx_idm_wifi_rx_flush(void);
+#endif
 
 #define CHAN2G(_idx, _freq) {			\
 	.band = NL80211_BAND_2GHZ,		\
@@ -1548,6 +1553,9 @@ void mt76_rx_complete(struct mt76_dev *dev, struct sk_buff_head *frames,
 	struct ieee80211_sta *sta;
 	struct ieee80211_hw *hw;
 	struct sk_buff *skb, *tmp;
+#ifdef CONFIG_ZX279128S_ETH
+	bool idm_flushed = false;
+#endif
 	LIST_HEAD(list);
 
 	spin_lock(&dev->rx_lock);
@@ -1578,8 +1586,18 @@ void mt76_rx_complete(struct mt76_dev *dev, struct sk_buff_head *frames,
 
 	list_for_each_entry_safe(skb, tmp, &list, list) {
 		skb_list_del_init(skb);
+#ifdef CONFIG_ZX279128S_ETH
+		if (zx_idm_wifi_rx(skb)) {
+			idm_flushed = true;
+			continue;
+		}
+#endif
 		napi_gro_receive(napi, skb);
 	}
+#ifdef CONFIG_ZX279128S_ETH
+	if (idm_flushed)
+		zx_idm_wifi_rx_flush();
+#endif
 }
 
 void mt76_rx_poll_complete(struct mt76_dev *dev, enum mt76_rxq_id q,
